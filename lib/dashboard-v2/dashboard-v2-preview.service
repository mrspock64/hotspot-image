[Unit]
Description=dashboard-v2 module-based dashboard preview (branch: signal-monitor, not production)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/hotspot-image/dashboard-v2
ExecStart=/usr/bin/php -S 0.0.0.0:8081 -t /opt/hotspot-image/dashboard-v2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
