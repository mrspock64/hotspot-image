[Unit]
Description=RX Monitor - stream SvxLink's QSO Recorder to the Web_Proxy
After=svxlink.service rx-monitor-proxy.service
Requires=rx-monitor-proxy.service

[Service]
Type=simple
User=svxlink
ExecStart=/opt/rx-monitor/tail_qso_recorder.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
